# Maintainer: Paras Sharma <parascodes247 at gmail dot com>

pkgname=ramwise-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Intelligent RAM usage visualizer for Arch Linux (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/Duckaet/ramwise"
license=('MIT')
provides=('ramwise')
conflicts=('ramwise')
depends=('gcc-libs')
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/ramwise-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/ramwise-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "$srcdir/ramwise-v$pkgver-x86_64-unknown-linux-gnu" 2>/dev/null || cd "$srcdir/ramwise-v$pkgver-aarch64-unknown-linux-gnu" 2>/dev/null || cd "$srcdir"
    install -Dm755 ramwise "$pkgdir/usr/bin/ramwise"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
